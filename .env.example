# =============================================================================
# .env.example — Copie este arquivo para .env e preencha os valores
# =============================================================================
# Comando: cp .env.example .env
# IMPORTANTE: O arquivo .env NUNCA deve ser commitado no GitHub!
# =============================================================================

# Sua chave da API-Football (obtenha em: https://dashboard.api-football.com)
API_FOOTBALL_KEY=sua_chave_aqui

# ID do usuário no Linux/WSL (rode no terminal WSL: echo $UID)
AIRFLOW_UID=50000

# Credenciais do admin do Airflow (interface web: localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Pacotes Python extras (deixe vazio)
_PIP_ADDITIONAL_REQUIREMENTS=
