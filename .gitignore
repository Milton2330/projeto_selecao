# =============================================================================
# .gitignore - Seleção Brasileira
# =============================================================================

# ⚠️  NUNCA suba o .env (tem sua chave da API e senhas!)
.env

# Logs do Airflow (gerados automaticamente, são enormes)
logs/
*.log

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/

# Ambientes virtuais
.venv/
venv/
env/

# Dados temporários / gerados
*.csv
*.json
*.parquet

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Docker volumes (não versionar dados do banco)
postgres_data/
